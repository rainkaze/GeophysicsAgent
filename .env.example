# 复制为 .env 后填写本机配置；请勿将真实 .env 提交到 GitHub。

# --- 大模型服务（OpenAI 兼容接口） ---
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=在这里填写你的_API_Key
LLM_MODEL=在这里填写模型名称
LLM_TIMEOUT_SECONDS=60
# 0 表示确定性输出，便于课堂复现
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
# 设为 false 可强制走规则方案（演示"模型不可用"路径）
ENABLE_LLM=true

# --- 应用 ---
APP_LOG_LEVEL=INFO

# --- 检索 ---
KNOWLEDGE_TOP_K=5

# --- 语义检索（对齐 Dify：向量 Embedding + Rerank） ---
# 阿里云百炼（DashScope）的 API Key，embedding 与 rerank 共用这一个 key（sk- 开头）。
# 留空时自动退回本地 BM25 词法检索（离线兜底，不报错、可运行）。
DASHSCOPE_API_KEY=
# 阿里云百炼 OpenAI 兼容接口地址（一般不用改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding 模型（与你在 Dify 里选的一致）
EMBEDDING_MODEL=text-embedding-v4
# Rerank 模型（与你在 Dify 里选的一致）
RERANK_MODEL=qwen3-rerank
# 是否启用语义检索：true = BM25 + 向量 + 重排（对齐 Dify）；false = 纯 BM25
ENABLE_SEMANTIC_RETRIEVAL=true

# --- 方案校验与修复 ---
# 模型方案未通过校验时最多回灌修复几次，0 表示不修复直接兜底
PLANNER_MAX_REPAIRS=1

# --- 会话记忆 ---
SESSION_MAX_SESSIONS=200
SESSION_TTL_MINUTES=120
